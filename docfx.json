{
  "metadata": [
    {
      "src": [
        {
          "files": [ "docfx.csproj" ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [ 
          "gdalicon.png",
          "favicon (1).png"
        ]
      }
    ],
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "GDAL C# API",
      "_appLogoPath": "gdalicon.png",
      "_appFaviconPath": "favicon (1).png",
      "_appFooter": "all logos and API contents ©️ GDAL contributors - see GDAL documentation for details"
    },
    "dest": "_site"
  }
}
